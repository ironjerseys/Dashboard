@page "/mail"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using global::Dashboard.Persistance.Entities

@attribute [Authorize(Roles = "Admin")]
@inherits LocalizedComponentBase
@inject IMailIngestionService Ingestion
@inject IEmailMessageService Messages

@rendermode RenderMode.InteractiveServer

<PageTitle>Mail</PageTitle>

<div class="mb-4 d-flex justify-content-between align-items-start gap-3">
    <div>
        <h1 class="mb-1">@Language.Translate("Boîte mail", "Mailbox")</h1>
        <p class="text-muted mb-0">
            @Language.Translate("Mails récupérés bruts, avant toute interprétation.",
                                "Raw messages pulled from the mailbox, before any parsing.")
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-outline-secondary" @onclick="FullResyncAsync" disabled="@_busy"
                title="@Language.Translate("Repart de la recherche par date au lieu du curseur UID", "Restarts from the date search instead of the UID cursor")">
            <i class="bi bi-clock-history me-1"></i>
            @Language.Translate("Tout rebalayer", "Full rescan")
        </button>
        <button class="btn btn-primary" @onclick="SyncAsync" disabled="@_busy">
            @if (_busy)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            }
            else
            {
                <i class="bi bi-arrow-repeat me-1"></i>
            }
            @Language.Translate("Synchroniser", "Sync now")
        </button>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">
        <div class="fw-semibold">@Language.Translate("Échec de la synchronisation", "Sync failed")</div>
        <pre class="small mb-0" style="white-space:pre-wrap">@_error</pre>
    </div>
}

@if (_result is not null)
{
    <div class="alert alert-success">
        @Language.Translate("Récupérés", "Fetched") : <strong>@_result.Fetched</strong> &nbsp;•&nbsp;
        @Language.Translate("Nouveaux", "Inserted") : <strong>@_result.Inserted</strong> &nbsp;•&nbsp;
        @Language.Translate("Doublons ignorés", "Duplicates skipped") : <strong>@_result.Duplicates</strong> &nbsp;•&nbsp;
        UID : <strong>@_result.LastSeenUid</strong>
        @if (_result.CursorWasReset)
        {
            <div class="small mt-1">
                @Language.Translate("Le serveur a changé d'UidValidity : le curseur a été réinitialisé.",
                                    "Server UidValidity changed: the cursor was reset.")
            </div>
        }
    </div>
}

@if (_loading)
{
    <div class="text-muted">@Language.Translate("Chargement…", "Loading…")</div>
}
else if (_messages.Count == 0)
{
    <div class="alert alert-info">
        @Language.Translate("Aucun mail en base. Clique sur Synchroniser.",
                            "No messages yet. Hit Sync now.")
    </div>
}
else
{
    <p class="text-muted small">
        @_total @Language.Translate("mails en base", "messages stored")
    </p>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th style="width:11rem">Date</th>
                    <th style="width:22rem">@Language.Translate("Expéditeur", "From")</th>
                    <th>@Language.Translate("Sujet", "Subject")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var message in _messages)
                {
                    var id = message.Id;
                    <tr role="button" @onclick="() => ToggleAsync(id)">
                        <td class="text-muted small">@message.SentUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <div class="text-truncate" style="max-width:21rem">
                                @(string.IsNullOrWhiteSpace(message.FromName) ? message.FromAddress : message.FromName)
                            </div>
                            @if (!string.IsNullOrWhiteSpace(message.FromName))
                            {
                                <div class="text-muted small text-truncate" style="max-width:21rem">@message.FromAddress</div>
                            }
                        </td>
                        <td>@message.Subject</td>
                    </tr>

                    @if (_openId == id)
                    {
                        <tr>
                            <td colspan="3" class="bg-body-tertiary">
                                @if (_openMessage is null)
                                {
                                    <div class="text-muted small">@Language.Translate("Chargement…", "Loading…")</div>
                                }
                                else
                                {
                                    <div class="small text-muted mb-2">
                                        Message-ID : <code>@_openMessage.MessageId</code> &nbsp;•&nbsp;
                                        UID @_openMessage.Uid &nbsp;•&nbsp; @_openMessage.Folder
                                    </div>
                                    <pre class="small mb-0" style="white-space:pre-wrap;max-height:24rem;overflow:auto">@BodyPreview(_openMessage)</pre>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool _busy;
    private bool _loading = true;
    private string? _error;
    private MailIngestionResult? _result;

    private List<EmailMessage> _messages = new();
    private int _total;

    private int? _openId;
    private EmailMessage? _openMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _messages = await Messages.GetRecentAsync(50);
            _total = await Messages.CountAsync();
        }
        catch (Exception ex) { _error = ex.ToString(); }
        finally { _loading = false; }
    }

    private async Task SyncAsync()
    {
        _busy = true;
        _error = null;
        _result = null;
        try
        {
            _result = await Ingestion.SyncAsync();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            // Trace complete a l'ecran : en developpement c'est ce qui fait gagner du temps.
            _error = ex.ToString();
        }
        finally { _busy = false; }
    }

    private async Task FullResyncAsync()
    {
        _busy = true;
        _error = null;
        _result = null;
        try
        {
            await Ingestion.ResetCursorAsync();
            _result = await Ingestion.SyncAsync();
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.ToString(); }
        finally { _busy = false; }
    }

    private async Task ToggleAsync(int id)
    {
        if (_openId == id)
        {
            _openId = null;
            _openMessage = null;
            return;
        }

        _openId = id;
        _openMessage = null;
        _openMessage = await Messages.GetAsync(id);
    }

    private static string BodyPreview(EmailMessage message)
    {
        var body = message.TextBody;

        if (string.IsNullOrWhiteSpace(body))
        {
            body = string.IsNullOrWhiteSpace(message.HtmlBody)
                ? "(aucun corps)"
                : message.HtmlBody;
        }

        return body.Length > 8000 ? body[..8000] + "\n…" : body;
    }
}
