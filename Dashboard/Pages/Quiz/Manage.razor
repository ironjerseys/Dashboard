@page "/quiz/manage"
@page "/quiz/questions"

@using System.Security.Claims
@using Dashboard.Components.Quiz
@using Dashboard.Components.Dashboard
@using Dashboard.Persistance.Entities
@using Dashboard.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web

@inject IDbQuizService QuizService
@inject ISqlChallengeService SqlService
@inject ICodeChallengeReviewService ChallengeService
@inject AuthenticationStateProvider AuthenticationStateProvider

@rendermode RenderMode.InteractiveServer

<PageTitle>Manage questions</PageTitle>

<div class="container-lg py-4">

    <div class="mb-4">
        <a href="/quiz/all" class="text-decoration-none small">&larr; Technical Questions</a>
        <h1 class="mb-1 mt-2">Manage questions</h1>
        <p class="text-muted mb-0">Create, edit and delete technical questions. Activate or deactivate questions, coding and SQL challenges.</p>
    </div>

    @if (!_isAdmin)
    {
        <div class="alert alert-warning">Access restricted to administrators.</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <span class="text-muted">
                @_items.Count item(s) &bull; @ActiveCount active &bull; @(_items.Count - ActiveCount) inactive
            </span>
            <button class="btn" @onclick="OpenCreateModal" disabled="@_busy">+ New question</button>
        </div>

        <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
            <input class="form-control" style="max-width:22rem" placeholder="Search question, answer or label…"
                   @bind="_search" @bind:event="oninput" @bind:after="OnFilterChanged" />
            <select class="form-select" style="max-width:12rem" @bind="_typeFilter" @bind:after="OnFilterChanged">
                <option value="all">All types</option>
                <option value="question">Questions (@_questions.Count)</option>
                <option value="coding">Coding (@_items.Count(i => i.Kind == ItemKind.Coding))</option>
                <option value="sql">SQL (@_items.Count(i => i.Kind == ItemKind.Sql))</option>
            </select>
            <select class="form-select" style="max-width:10rem" @bind="_statusFilter" @bind:after="OnFilterChanged">
                <option value="all">All</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }

        @if (_busy && _items.Count == 0)
        {
            <div class="text-muted">Loading…</div>
        }
        else if (_rows.Count == 0)
        {
            <div class="alert alert-info">No item matches.</div>
        }
        else
        {
            <div class="d-flex align-items-center flex-wrap gap-3 mb-3">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="select-all"
                           checked="@AllRowsSelected" @onchange="ToggleSelectAll" disabled="@_busy" />
                    <label class="form-check-label" for="select-all">Select all (@_rows.Count)</label>
                </div>
                @if (_selected.Count > 0)
                {
                    <span class="text-muted small">@_selected.Count selected</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => SetSelectedActiveAsync(false)" disabled="@_busy">
                        <i class="bi bi-toggle-off me-1"></i>Deactivate
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => SetSelectedActiveAsync(true)" disabled="@_busy">
                        <i class="bi bi-toggle-on me-1"></i>Activate
                    </button>
                    <a href="" class="small" @onclick="ClearSelection" @onclick:preventDefault="true">Clear selection</a>
                }
                <span class="text-muted small ms-auto">
                    @((_page - 1) * PageSize + 1)–@Math.Min(_page * PageSize, _rows.Count) of @_rows.Count
                </span>
            </div>
        }

        @foreach (var item in PageRows)
        {
            var question = item.Question;
            <div class="card p-3 mb-3 @(item.IsActive ? "" : "opacity-50")" @key="item.Key">
                <div class="d-flex justify-content-between gap-3 flex-wrap">
                    <div class="form-check mb-0 flex-shrink-0">
                        <input class="form-check-input" type="checkbox" title="Select"
                               checked="@_selected.Contains(item.Key)"
                               @onchange="e => ToggleSelected(item.Key, e.Value is true)"
                               disabled="@_busy" />
                    </div>
                    <div class="flex-grow-1 min-w-0">
                        @if (question is null)
                        {
                            <div class="fw-semibold mb-2">
                                @if (!item.IsActive)
                                {
                                    <span class="badge bg-secondary me-2">Inactive</span>
                                }
                                <span class="badge @(item.Kind == ItemKind.Sql ? "bg-info" : "bg-primary") me-2">@(item.Kind == ItemKind.Sql ? "SQL" : "Coding")</span>
                                <a href="@item.Href" class="text-decoration-none">@item.Title</a>
                            </div>
                            <div class="text-muted small">@item.Description</div>
                        }
                        else
                        {
                            <div class="fw-semibold mb-2">
                                @if (!item.IsActive)
                                {
                                    <span class="badge bg-secondary me-2">Inactive</span>
                                }
                                @QuizRender.RenderQuestionText(question.QuestionText)
                            </div>

                            <ol class="mb-2 ps-3">
                                @for (int ci = 0; ci < 4; ci++)
                                {
                                    var isCorrect = question.CorrectAnswer == ci;
                                    <li class="@(isCorrect ? "text-success fw-semibold" : "")">
                                        @QuizRender.RenderInlineHtmlOrText(QuizRender.GetChoiceText(question, ci))
                                    </li>
                                }
                            </ol>

                            @if (!string.IsNullOrWhiteSpace(question.Explanation))
                            {
                                <div class="mt-2">
                                    <div class="text-muted small fw-semibold mb-1">Explanation</div>
                                    @if (QuizRender.LooksLikeHtml(question.Explanation))
                                    {
                                        <div class="quiz-html">@((MarkupString)(question.Explanation ?? string.Empty))</div>
                                    }
                                    else
                                    {
                                        <div class="text-muted">@question.Explanation</div>
                                    }
                                </div>
                            }

                            <div class="small text-muted mt-2">
                                Correct answer: <strong>@(question.CorrectAnswer + 1)</strong>
                                @if (question.Labels.Count > 0)
                                {
                                    <span class="mx-2">&bull;</span>
                                    <span>@string.Join(", ", question.Labels.Select(l => l.Name))</span>
                                }
                            </div>
                        }
                    </div>

                    <div class="d-flex gap-2 align-items-start flex-shrink-0">
                        <div class="form-check form-switch mb-0 mt-2" title="@(item.IsActive ? "Active — click to deactivate" : "Inactive — click to activate")">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   checked="@item.IsActive"
                                   @onchange="e => SetActiveAsync(item, e.Value is true)"
                                   disabled="@_busy" />
                        </div>
                        @if (question is not null)
                        {
                            <button class="btn" title="Edit"
                                    @onclick="() => OpenEditModal(question)"
                                    disabled="@_busy">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn" title="Delete"
                                    @onclick="() => AskDelete(question)"
                                    disabled="@_busy">
                                <i class="bi bi-trash"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }

        @if (PageCount > 1)
        {
            <nav class="mb-4">
                <ul class="pagination pagination-sm flex-wrap mb-0">
                    <li class="page-item @(_page == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(_page - 1)">&laquo;</button>
                    </li>
                    @foreach (int? number in PageNumbers())
                    {
                        if (number is { } n)
                        {
                            <li class="page-item @(n == _page ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(n)">@n</button>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                    }
                    <li class="page-item @(_page == PageCount ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(_page + 1)">&raquo;</button>
                    </li>
                </ul>
            </nav>
        }

        <QuizQuestionEditorModal IsOpen="_editorOpen"
                                 IsOpenChanged="OnEditorOpenChanged"
                                 Title="@_editorTitle"
                                 SubmitLabel="@_editorSubmitLabel"
                                 Busy="_busy"
                                 Error="_editorError"
                                 Model="_editorModel"
                                 OnSubmit="SaveQuestionAsync" />

        <ConfirmModal IsOpen="_deleteConfirmOpen"
                      IsOpenChanged="OnDeleteConfirmOpenChanged"
                      Title="Delete question"
                      Message="@_deleteMessage"
                      ConfirmLabel="Delete"
                      Busy="_busy"
                      OnConfirm="DeleteConfirmedAsync" />
    }

</div>

@code {
    private const int PageSize = 20;

    private bool _isAdmin;

    private bool _busy;
    private string? _error;
    private List<QuestionTechnique> _questions = new();
    private List<ManageItem> _items = new();
    private List<ManageItem> _rows = new();
    private readonly HashSet<string> _selected = new();
    private string? _search;
    private string _typeFilter = "all";
    private string _statusFilter = "all";

    private enum ItemKind { Question, Coding, Sql }

    // Une ligne de la liste : une question technique, ou un defi de code / SQL.
    // Les defis n'ont ni edition ni suppression ici, seulement l'activation.
    private sealed class ManageItem
    {
        public required string Key { get; init; }
        public required ItemKind Kind { get; init; }
        public QuestionTechnique? Question { get; init; }
        public string Title { get; init; } = "";
        public string Description { get; init; } = "";
        public string Href { get; init; } = "";
        public bool IsActive { get; set; }
    }

    private static string QuestionKey(int id) => $"q-{id}";
    private int _page = 1;
    private bool _editorOpen;
    private string _editorTitle = "";
    private string _editorSubmitLabel = "";
    private string? _editorError;
    private QuestionTechnique _editorModel = new();
    private bool _isEditMode;
    private bool _deleteConfirmOpen;
    private int _deleteQuestionId;
    private string _deleteMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole("Admin");

        if (_isAdmin)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _questions = await QuizService.GetQuestionsAsync();
            var sqlChallenges = await SqlService.GetAllAsync();
            var inactiveKeys = await ChallengeService.GetInactiveKeysAsync();

            _items = _questions
                .Select(q => new ManageItem
                {
                    Key = QuestionKey(q.Id),
                    Kind = ItemKind.Question,
                    Question = q,
                    IsActive = q.IsActive
                })
                .Concat(CodingChallengeCatalog.All.Select(c => new ManageItem
                {
                    Key = c.Key,
                    Kind = ItemKind.Coding,
                    Title = c.Title,
                    Description = c.Description,
                    Href = c.Href,
                    IsActive = !inactiveKeys.Contains(c.Key)
                }))
                .Concat(sqlChallenges.Select(c => new ManageItem
                {
                    Key = CodingChallengeCatalog.SqlKey(c.Id),
                    Kind = ItemKind.Sql,
                    Title = c.Title,
                    Description = c.Prompt,
                    Href = $"/coding/sql/{c.Id}",
                    IsActive = !inactiveKeys.Contains(CodingChallengeCatalog.SqlKey(c.Id))
                }))
                .ToList();

            _selected.IntersectWith(_items.Select(i => i.Key));
            ApplyView();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private int ActiveCount => _items.Count(i => i.IsActive);
    private int PageCount => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)PageSize));
    private IEnumerable<ManageItem> PageRows => _rows.Skip((_page - 1) * PageSize).Take(PageSize);
    private bool AllRowsSelected => _rows.Count > 0 && _rows.All(i => _selected.Contains(i.Key));

    private void ApplyView()
    {
        IEnumerable<ManageItem> rows = _typeFilter switch
        {
            "question" => _items.Where(i => i.Kind == ItemKind.Question),
            "coding" => _items.Where(i => i.Kind == ItemKind.Coding),
            "sql" => _items.Where(i => i.Kind == ItemKind.Sql),
            _ => _items
        };

        rows = _statusFilter switch
        {
            "active" => rows.Where(i => i.IsActive),
            "inactive" => rows.Where(i => !i.IsActive),
            _ => rows
        };

        if (!string.IsNullOrWhiteSpace(_search))
        {
            string term = _search.Trim();
            rows = rows.Where(q => MatchesSearch(q, term));
        }

        _rows = rows.ToList();
        _page = Math.Clamp(_page, 1, PageCount);
    }

    private void OnFilterChanged()
    {
        _page = 1;
        ApplyView();
    }

    private static bool MatchesSearch(ManageItem item, string term)
    {
        if (item.Question is not { } q)
            return item.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
                || item.Description.Contains(term, StringComparison.OrdinalIgnoreCase);

        return new[] { q.QuestionText, q.Choice0, q.Choice1, q.Choice2, q.Choice3 }
                   .Any(text => QuizRender.ToPlainText(text).Contains(term, StringComparison.OrdinalIgnoreCase))
               || q.Labels.Any(l => l.Name.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private void GoToPage(int page) => _page = Math.Clamp(page, 1, PageCount);

    /// <summary>Premiere, derniere, et deux pages autour de la courante ; null pour une ellipse.</summary>
    private IEnumerable<int?> PageNumbers()
    {
        int? previous = null;

        for (int n = 1; n <= PageCount; n++)
        {
            if (n != 1 && n != PageCount && Math.Abs(n - _page) > 2)
            {
                continue;
            }

            if (previous is { } p && n - p > 1)
            {
                yield return null;
            }

            yield return n;
            previous = n;
        }
    }

    private void ToggleSelected(string key, bool selected)
    {
        if (selected) _selected.Add(key);
        else _selected.Remove(key);
    }

    // "Select all" porte sur tous les resultats filtres, toutes pages confondues.
    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (e.Value is true) _selected.UnionWith(_rows.Select(i => i.Key));
        else _selected.ExceptWith(_rows.Select(i => i.Key));
    }

    private void ClearSelection() => _selected.Clear();

    private async Task SetActiveAsync(ManageItem item, bool isActive)
    {
        _error = null;
        try
        {
            _busy = true;
            await SaveActiveAsync(new[] { item }, isActive);
            ApplyView();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SetSelectedActiveAsync(bool isActive)
    {
        _error = null;
        try
        {
            _busy = true;
            await SaveActiveAsync(_items.Where(i => _selected.Contains(i.Key)).ToList(), isActive);
            _selected.Clear();
            ApplyView();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // Les questions ont leur colonne IsActive ; les defis passent par la table des defis inactifs.
    private async Task SaveActiveAsync(IReadOnlyCollection<ManageItem> items, bool isActive)
    {
        var questionIds = items.Where(i => i.Question is not null).Select(i => i.Question!.Id).ToList();
        var challengeKeys = items.Where(i => i.Question is null).Select(i => i.Key).ToList();

        if (questionIds.Count > 0)
            await QuizService.SetActiveAsync(questionIds, isActive);
        if (challengeKeys.Count > 0)
            await ChallengeService.SetActiveAsync(challengeKeys, isActive);

        foreach (var item in items)
        {
            item.IsActive = isActive;
            if (item.Question is not null)
                item.Question.IsActive = isActive;
        }
    }

    private void OpenCreateModal()
    {
        _isEditMode = false;
        _editorTitle = "New question";
        _editorSubmitLabel = "Create";
        _editorError = null;
        _editorModel = new QuestionTechnique { CorrectAnswer = 0 };
        _editorOpen = true;
    }

    private void OpenEditModal(QuestionTechnique question)
    {
        _isEditMode = true;
        _editorTitle = "Edit question";
        _editorSubmitLabel = "Save";
        _editorError = null;
        _editorModel = new QuestionTechnique
        {
            Id = question.Id,
            QuestionText = question.QuestionText,
            Choice0 = question.Choice0,
            Choice1 = question.Choice1,
            Choice2 = question.Choice2,
            Choice3 = question.Choice3,
            CorrectAnswer = question.CorrectAnswer,
            Explanation = question.Explanation
        };
        _editorOpen = true;
    }

    private Task OnEditorOpenChanged(bool open) { _editorOpen = open; return Task.CompletedTask; }

    private async Task SaveQuestionAsync(QuestionTechnique model)
    {
        _editorError = null;
        try
        {
            _busy = true;
            if (_isEditMode)
            {
                bool ok = await QuizService.UpdateAsync(model);
                if (!ok) { _editorError = "Question not found."; return; }
            }
            else
            {
                await QuizService.CreateAsync(model);
            }
            _editorOpen = false;
            await LoadAsync();
        }
        catch (Exception ex) { _editorError = ex.Message; }
        finally { _busy = false; }
    }

    private void AskDelete(QuestionTechnique question)
    {
        _deleteQuestionId = question.Id;
        _deleteMessage = $"Delete this question?\n\n\"{QuizRender.MakePreview(question.QuestionText, 90)}\"\n\nThis action is permanent.";
        _deleteConfirmOpen = true;
    }

    private Task OnDeleteConfirmOpenChanged(bool open) { _deleteConfirmOpen = open; return Task.CompletedTask; }

    private async Task DeleteConfirmedAsync()
    {
        try
        {
            _busy = true;
            await QuizService.DeleteAsync(_deleteQuestionId);
            _deleteConfirmOpen = false;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
