@page "/job-data"

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Dashboard.Components.Jobs

@inherits LocalizedComponentBase
@inject IJobPostingService JobService
@inject IJobDataSettingsService SettingsService
@inject ScraperTriggerService Scraper
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

@rendermode RenderMode.InteractiveServer

<div class="mb-4 d-flex flex-wrap align-items-start justify-content-between gap-3">
    <div>
        <h1 class="mb-1">@Language.Translate("Offres d'emploi", "Job Listings")</h1>
        <p class="text-muted mb-0">@Language.Translate("Aperçu du marché, actualisé chaque semaine.", "Live market overview, refreshed weekly.")</p>
    </div>

    @if (_isAdmin)
    {
        <div class="text-end">
            <button type="button" class="icon-btn me-2 align-middle" title="@Language.Translate("Paramètres", "Settings")"
                    aria-label="@Language.Translate("Paramètres", "Settings")" @onclick="() => _settingsOpen = true">
                <i class="bi bi-sliders"></i>
            </button>
            <button class="btn btn-primary" @onclick="RunScraperAsync" disabled="@(_scraperRunning || _scraperBusy)">
                @if (_scraperRunning)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    @Language.Translate("Scraping en cours…", "Scraping…")
                }
                else
                {
                    <i class="bi bi-play-fill me-1"></i>
                    @Language.Translate("Lancer le scraper", "Run scraper")
                }
            </button>
            @if (_scraperMessage is not null)
            {
                <div class="small text-muted mt-1">@_scraperMessage</div>
            }
        </div>
    }
</div>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else if (_busy)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">@Language.Translate("Chargement des stats…", "Loading stats…")</p>
        </div>
    }
    else if (_stats is null || _stats.TotalCount == 0)
    {
        <div class="alert alert-info">
            @Language.Translate("Aucune offre en base. Le scraper tourne tous les dimanches à 3h UTC.",
                  "No listings in the database. The scraper runs every Sunday at 3 AM UTC.")<br />
            @Language.Translate("Pour lancer manuellement :", "To run manually:")&nbsp;<code>docker compose exec jobspy python /app/scrape_jobs.py</code>
        </div>
    }
    else
    {
        <!-- KPI strip -->
        <div class="stat-bar mb-4">
            <div class="stat-bar-item accent">
                <i class="bi bi-briefcase stat-bar-icon"></i>
                <div>
                    <div class="stat-bar-num">@_stats.TotalCount.ToString("N0")</div>
                    <div class="stat-bar-label">@Language.Translate("Offres totales", "Total listings")</div>
                </div>
            </div>
            <div class="stat-bar-item">
                <i class="bi bi-house-door stat-bar-icon"></i>
                <div>
                    <div class="stat-bar-num">@RemotePct%</div>
                    <div class="stat-bar-label">Remote</div>
                </div>
            </div>
            <div class="stat-bar-item">
                <i class="bi bi-tags stat-bar-icon"></i>
                <div>
                    <div class="stat-bar-num">@_stats.ByRole.Count</div>
                    <div class="stat-bar-label">@Language.Translate("Rôles suivis", "Tracked roles")</div>
                </div>
            </div>
            <div class="stat-bar-item">
                <i class="bi bi-clock-history stat-bar-icon"></i>
                <div>
                    <div class="stat-bar-num" style="font-size:1.15rem;">@(_stats.LastScrapeAt?.ToString("dd/MM/yyyy") ?? "—")</div>
                    <div class="stat-bar-label">@Language.Translate("Dernier scraping", "Last scrape")</div>
                </div>
            </div>
        </div>

        <!-- Row 1 : évolution par rôle -->
        @if (IsVisible("role-trend"))
        {
        <div class="row g-4 mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">@ChartTitle("role-trend")</div>
                    <div class="card-body" style="height:340px;">
                        <canvas id="weekChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        }

        <!-- Row 2 : évolution par ville -->
        @if (IsVisible("city-trend"))
        {
        <div class="row g-4 mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">@ChartTitle("city-trend")</div>
                    <div class="card-body">
                        <!-- Filtres : ne s'appliquent qu'à ce graphe -->
                        <div class="mb-3">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <strong class="me-2" style="min-width:4rem;">@Language.Translate("Rôles", "Roles")</strong>
                                @foreach (var role in _roles)
                                {
                                    var id = $"role-{_roles.IndexOf(role)}";
                                    <div class="form-check form-check-inline mb-0">
                                        <input class="form-check-input" type="checkbox" id="@id"
                                               checked="@_selectedRoles.Contains(role)"
                                               @onchange="e => ToggleAsync(_selectedRoles, role, (bool)e.Value!)" />
                                        <label class="form-check-label" for="@id">@role</label>
                                    </div>
                                }
                                <button class="btn btn-link btn-sm p-0 ms-auto" @onclick="() => SetAllAsync(_selectedRoles, _roles, true)">@Language.Translate("Tous", "All")</button>
                                <span class="text-muted">/</span>
                                <button class="btn btn-link btn-sm p-0" @onclick="() => SetAllAsync(_selectedRoles, _roles, false)">@Language.Translate("Aucun", "None")</button>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <strong class="me-2" style="min-width:4rem;">@Language.Translate("Villes", "Cities")</strong>
                                @foreach (var city in _cities)
                                {
                                    var id = $"city-{_cities.IndexOf(city)}";
                                    <div class="form-check form-check-inline mb-0">
                                        <input class="form-check-input" type="checkbox" id="@id"
                                               checked="@_selectedCities.Contains(city)"
                                               @onchange="e => ToggleAsync(_selectedCities, city, (bool)e.Value!)" />
                                        <label class="form-check-label" for="@id">@city</label>
                                    </div>
                                }
                                <button class="btn btn-link btn-sm p-0 ms-auto" @onclick="() => SetAllAsync(_selectedCities, _cities, true)">@Language.Translate("Toutes", "All")</button>
                                <span class="text-muted">/</span>
                                <button class="btn btn-link btn-sm p-0" @onclick="() => SetAllAsync(_selectedCities, _cities, false)">@Language.Translate("Aucune", "None")</button>
                            </div>
                        </div>
                        <div style="height:340px;">
                            <canvas id="cityTrendChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        }

        <!-- Row 3 -->
        @if (RowVisible(3))
        {
        <div class="row g-4 mb-4">
            @if (IsVisible("by-role"))
            {
            <div class="@ColClass("by-role")">
                <div class="card h-100">
                    <div class="card-header">@ChartTitle("by-role")</div>
                    <div class="card-body">
                        <canvas id="roleChart"></canvas>
                    </div>
                </div>
            </div>
            }
            @if (IsVisible("by-city"))
            {
            <div class="@ColClass("by-city")">
                <div class="card h-100">
                    <div class="card-header">@ChartTitle("by-city")</div>
                    <div class="card-body">
                        <canvas id="cityChart"></canvas>
                    </div>
                </div>
            </div>
            }
        </div>
        }

        <!-- Row 4 -->
        @if (RowVisible(4))
        {
        <div class="row g-4">
            @if (IsVisible("by-site"))
            {
            <div class="@ColClass("by-site")">
                <div class="card h-100">
                    <div class="card-header">@ChartTitle("by-site")</div>
                    <div class="card-body d-flex align-items-center justify-content-center">
                        <div style="width:100%;max-width:220px;">
                            <canvas id="siteChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            }
            @if (IsVisible("role-city"))
            {
            <div class="@ColClass("role-city")">
                <div class="card h-100">
                    <div class="card-header">@ChartTitle("role-city")</div>
                    <div class="card-body" style="height: @($"{Math.Max(280, _stats.ByCity.Count * _stats.ByRole.Count * 22 + 60)}px")">
                        <canvas id="roleCityChart"></canvas>
                    </div>
                </div>
            </div>
            }
        </div>
        }

        @if (ChartDefs.All(c => !IsVisible(c.Key)))
        {
            <div class="alert alert-info">@Language.Translate("Tous les graphes sont masqués.", "All charts are hidden.")</div>
        }
    }

@if (_isAdmin)
{
    <JobDataSettingsModal IsOpen="_settingsOpen"
                          IsOpenChanged="open => _settingsOpen = open"
                          Charts="ChartOptions"
                          HiddenCharts="_hiddenCharts"
                          HiddenChartsChanged="OnHiddenChartsChanged" />
}

@code {
    // Graphes de la page. Row = ligne d'affichage ; si un graphe est seul visible sur sa ligne,
    // il prend toute la largeur. Key = clé stockée dans HiddenJobCharts.
    private sealed record ChartDef(string Key, string TitleFr, string TitleEn, int Row, string ColClass);

    private static readonly ChartDef[] ChartDefs =
    [
        new("role-trend", "Évolution (par run de scraping)", "Trend (by scraping run)", 1, "col-12"),
        new("city-trend", "Évolution par ville (par run de scraping)", "Trend by city (by scraping run)", 2, "col-12"),
        new("by-role", "Offres par rôle", "Listings by role", 3, "col-md-6"),
        new("by-city", "Offres par ville", "Listings by city", 3, "col-md-6"),
        new("by-site", "Répartition par site", "Distribution by source", 4, "col-md-4"),
        new("role-city", "Offres par rôle et par ville", "Listings by role and city", 4, "col-md-8"),
    ];

    private HashSet<string> _hiddenCharts = new();
    private bool _settingsOpen;

    private bool IsVisible(string key) => !_hiddenCharts.Contains(key);
    private bool RowVisible(int row) => ChartDefs.Any(c => c.Row == row && IsVisible(c.Key));

    private string ChartTitle(string key)
    {
        var def = ChartDefs.First(c => c.Key == key);
        return Language.Translate(def.TitleFr, def.TitleEn);
    }

    private string ColClass(string key)
    {
        var def = ChartDefs.First(c => c.Key == key);
        bool alone = ChartDefs.Count(c => c.Row == def.Row && IsVisible(c.Key)) == 1;
        return alone ? "col-12" : def.ColClass;
    }

    private IReadOnlyList<JobDataSettingsModal.ChartOption> ChartOptions =>
        ChartDefs.Select(c => new JobDataSettingsModal.ChartOption(c.Key, ChartTitle(c.Key))).ToList();

    // Un graphe réaffiché a un nouveau canvas : on redessine tout au prochain rendu.
    private void OnHiddenChartsChanged() => _chartsDrawn = false;

    // Même palette que jobcharts.js : une couleur fixe par rôle / ville, stable quand on filtre.
    private static readonly string[] Palette =
        ["#4e79a7", "#f28e2b", "#e15759", "#76b7b2", "#59a14f", "#edc948", "#b07aa1", "#ff9da7", "#9c755f", "#bab0ac"];

    private bool _busy;
    private string? _error;
    private JobStats? _stats;
    private bool _chartsDrawn;

    private List<string> _roles = [];
    private List<string> _cities = [];
    private readonly HashSet<string> _selectedRoles = [];
    private readonly HashSet<string> _selectedCities = [];

    private bool _isAdmin;
    private bool _scraperRunning;
    private bool _scraperBusy;
    private string? _scraperMessage;
    private CancellationTokenSource? _pollCts;

    private int RemotePct => _stats is { TotalCount: > 0 }
        ? (int)Math.Round(_stats.RemoteCount * 100.0 / _stats.TotalCount)
        : 0;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Language.OnChange += OnLangChange;
    }

    private void OnLangChange() => _chartsDrawn = false;

    public override void Dispose()
    {
        Language.OnChange -= OnLangChange;
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        base.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isAdmin = auth.User.IsInRole("Admin");

        await ReloadAsync();

        if (_isAdmin)
        {
            var status = await Scraper.GetStatusAsync();
            if (status is { Running: true })
            {
                _scraperRunning = true;
                _scraperMessage = StartedMessage(status);
                StartPolling();
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_stats is { TotalCount: > 0 } && !_chartsDrawn)
        {
            _chartsDrawn = true;
            await DrawChartsAsync();
        }
    }

    private async Task ReloadAsync()
    {
        _busy = true;
        _error = null;
        _chartsDrawn = false;
        StateHasChanged();

        try
        {
            _stats = await JobService.GetStatsAsync();
            _hiddenCharts = await SettingsService.GetHiddenChartsAsync();

            // Les nouveaux rôles / villes (ex. après un run) sont cochés par défaut ; les choix existants sont conservés.
            var newRoles = _stats.ByRole.Select(x => x.Label).Except(_roles);
            var newCities = _stats.ByCity.Select(x => x.Label).Except(_cities);
            _selectedRoles.UnionWith(newRoles);
            _selectedCities.UnionWith(newCities);
            _roles = _stats.ByRole.Select(x => x.Label).OrderBy(x => x).ToList();
            _cities = _stats.ByCity.Select(x => x.Label).OrderBy(x => x).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    // ----- Filtres -----

    private async Task ToggleAsync(HashSet<string> set, string value, bool selected)
    {
        if (selected) set.Add(value); else set.Remove(value);
        await DrawCityTrendChartAsync();
    }

    private async Task SetAllAsync(HashSet<string> set, List<string> all, bool selected)
    {
        set.Clear();
        if (selected) set.UnionWith(all);
        await DrawCityTrendChartAsync();
    }

    // ----- Scraper -----

    private async Task RunScraperAsync()
    {
        // Le bouton n'est rendu que pour un Admin, mais on revérifie côté serveur.
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!auth.User.IsInRole("Admin")) return;

        _scraperBusy = true;
        _scraperMessage = null;
        try
        {
            var result = await Scraper.StartAsync();
            _scraperRunning = true;
            _scraperMessage = result == ScraperStartResult.AlreadyRunning
                ? Language.Translate("Un scraping est déjà en cours.", "A scrape is already running.")
                : Language.Translate("Scraping lancé. Ça peut prendre un moment…", "Scrape started. This can take a while…");
            StartPolling();
        }
        catch (Exception ex)
        {
            _scraperMessage = Language.Translate("Impossible de joindre le scraper : ", "Could not reach the scraper: ") + ex.Message;
        }
        finally
        {
            _scraperBusy = false;
        }
    }

    private void StartPolling()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = new CancellationTokenSource();
        _ = PollAsync(_pollCts.Token);
    }

    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(20));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                var status = await Scraper.GetStatusAsync(ct);
                if (status is null || status.Running) continue;

                await InvokeAsync(async () =>
                {
                    _scraperRunning = false;
                    _scraperMessage = status.ExitCode == 0
                        ? Language.Translate("Scraping terminé.", "Scrape finished.")
                        : Language.Translate($"Scraping terminé avec une erreur (code {status.ExitCode}).", $"Scrape finished with an error (code {status.ExitCode}).");
                    await ReloadAsync();
                    StateHasChanged();
                });
                return;
            }
        }
        catch (OperationCanceledException)
        {
            // Page fermée.
        }
    }

    private string StartedMessage(ScraperStatus status) =>
        Language.Translate("Scraping en cours depuis ", "Scrape running since ")
        + (status.StartedAt?.ToLocalTime().ToString("HH:mm") ?? "?");

    // ----- Graphes -----

    private string RoleColor(string role) => Palette[Math.Max(0, _roles.IndexOf(role)) % Palette.Length];
    private string CityColor(string city) => Palette[Math.Max(0, _cities.IndexOf(city)) % Palette.Length];

    private async Task DrawChartsAsync()
    {
        if (_stats is null) return;

        try
        {
            await DrawRoleTrendChartAsync();
            await DrawCityTrendChartAsync();

            await JS.InvokeVoidAsync("JobCharts.bar",
                "roleChart",
                _stats.ByRole.Select(x => x.Label).ToArray(),
                _stats.ByRole.Select(x => x.Count).ToArray(),
                Language.Translate("Offres", "Listings"),
                _stats.ByRole.Select(x => RoleColor(x.Label)).ToArray());

            await JS.InvokeVoidAsync("JobCharts.bar",
                "cityChart",
                _stats.ByCity.Select(x => x.Label).ToArray(),
                _stats.ByCity.Select(x => x.Count).ToArray(),
                Language.Translate("Offres", "Listings"),
                _stats.ByCity.Select(x => CityColor(x.Label)).ToArray());

            await JS.InvokeVoidAsync("JobCharts.doughnut",
                "siteChart",
                _stats.BySite.Select(x => x.Label).ToArray(),
                _stats.BySite.Select(x => x.Count).ToArray());

            var roles = _stats.ByRole.Select(x => x.Label).ToList();
            var cities = _stats.ByCity.Select(x => x.Label).ToList();
            var lookup = _stats.ByRoleCity
                .GroupBy(x => (x.Role, x.City))
                .ToDictionary(g => g.Key, g => g.Sum(x => x.Count));

            var datasets = roles.Select(role => new
            {
                label = role,
                color = RoleColor(role),
                data = cities.Select(city => lookup.TryGetValue((role, city), out var c) ? c : 0).ToArray()
            }).ToArray();

            await JS.InvokeVoidAsync("JobCharts.groupedBar", "roleCityChart", cities.ToArray(), datasets);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering job charts: {ex.Message}");
        }
    }

    private List<DateTime> Runs() => _stats!.ByRun.Select(x => x.RunDate).Distinct().OrderBy(d => d).ToList();

    /// Évolution par rôle, toutes villes confondues (non filtrée).
    private async Task DrawRoleTrendChartAsync()
    {
        if (_stats is null) return;

        var runs = Runs();
        var byRole = _stats.ByRun.GroupBy(x => (x.Role, x.RunDate)).ToDictionary(g => g.Key, g => g.Sum(x => x.Count));
        var datasets = _roles.Select(role => new
        {
            label = role,
            color = RoleColor(role),
            data = runs.Select(d => byRole.TryGetValue((role, d), out var c) ? c : 0).ToArray()
        }).ToArray();

        await JS.InvokeVoidAsync("JobCharts.multiLine", "weekChart", runs.Select(d => d.ToString("dd/MM/yy")).ToArray(), datasets);
    }

    /// Évolution par ville : une courbe par ville cochée, sommée sur les rôles cochés.
    private async Task DrawCityTrendChartAsync()
    {
        if (_stats is null) return;

        var runs = Runs();
        var labels = runs.Select(d => d.ToString("dd/MM/yy")).ToArray();
        var filtered = _stats.ByRun
            .Where(x => _selectedRoles.Contains(x.Role) && _selectedCities.Contains(x.City))
            .ToList();

        var byCity = filtered.GroupBy(x => (x.City, x.RunDate)).ToDictionary(g => g.Key, g => g.Sum(x => x.Count));
        var cityDatasets = _cities.Where(_selectedCities.Contains).Select(city => new
        {
            label = city,
            color = CityColor(city),
            data = runs.Select(d => byCity.TryGetValue((city, d), out var c) ? c : 0).ToArray()
        }).ToArray();

        try
        {
            await JS.InvokeVoidAsync("JobCharts.multiLine", "cityTrendChart", labels, cityDatasets);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering city trend chart: {ex.Message}");
        }
    }
}
